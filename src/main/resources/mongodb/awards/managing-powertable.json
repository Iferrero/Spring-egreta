{
  "collection": "Awards",
  "pipeline": [
    {
      "$match": {
        "workflow.step": "validated"
      }
    },
    {
      "$match": {
        "$or": [
          { "managingOrganization.uuid": "__MANAGING_UUID__" },
          { "coManagingOrganizations.uuid": "__MANAGING_UUID__" }
        ]
      }
    },
    {
      "$match": {
        "type.term.ca_ES": {
          "$ne": "Grups i Xarxes de Recerca externs a la UAB"
        }
      }
    },
    {
      "$addFields": {
        "anio": {
          "$cond": [
            { "$ifNull": ["$awardDate", false] },
            { "$year": "$awardDate" },
            null
          ]
        }
      }
    },
    {
      "$unwind": "$fundings"
    },
    {
      "$unwind": "$fundings.fundingCollaborators"
    },
    {
      "$match": {
        "fundings.fundingCollaborators.collaborator.uuid":
          "84443078-1a60-462d-9d0a-b04312afd9eb"
      }
    },
    {
      "$addFields": {
        "importe": {
          "$convert": {
            "input": "$fundings.fundingCollaborators.institutionalPart.value",
            "to": "double",
            "onError": 0,
            "onNull": 0
          }
        }
      }
    },
    {
      "$group": {
        "_id": {
          "awardUuid": "$uuid",
          "anio": "$anio",
          "tipo": "$type.term.ca_ES",
          "categoria": "$categoria"
        },
        "totalImporte": {
          "$sum": "$importe"
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "awardUuid": "$_id.awardUuid",
        "anio": "$_id.anio",
        "tipo": "$_id.tipo",
        "categoria": {
          "$ifNull": ["$_id.categoria", "Sense categoria"]
        },
        "importe": "$totalImporte"
      }
    },
    {
      "$group": {
        "_id": {
          "anio": "$anio",
          "tipo": "$tipo",
          "categoria": "$categoria"
        },
        "ajuts": {
          "$sum": 1
        },
        "import": {
          "$sum": "$importe"
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "anio": "$_id.anio",
        "categoria": "$_id.categoria",
        "tipo": "$_id.tipo",
        "ajuts": 1,
        "import": {
          "$round": ["$import", 2]
        }
      }
    },
    {
      "$sort": {
        "anio": 1,
        "categoria": 1,
        "tipo": 1
      }
    }
  ]
}