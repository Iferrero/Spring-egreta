{
  "collection": "Awards",
  "pipeline": [
    {
      "$match": {
        "workflow.step": "validated"
      }
    },
    {
      "$match": {
        "type.term.ca_ES": {
          "$ne": "Grups i Xarxes de Recerca externs a la UAB"
        }
      }
    },
    {
      "$lookup": {
        "from": "Applications",
        "localField": "applications.uuid",
        "foreignField": "uuid",
        "as": "appDocs"
      }
    },
    {
      "$unwind": {
        "path": "$appDocs",
        "preserveNullAndEmptyArrays": true
      }
    },
    {
      "$lookup": {
        "from": "FundingOpportunities",
        "localField": "appDocs.fundingOpportunity.uuid",
        "foreignField": "uuid",
        "as": "fOpp"
      }
    },
    {
      "$unwind": {
        "path": "$fOpp",
        "preserveNullAndEmptyArrays": true
      }
    },
    {
      "$addFields": {
        "anio": {
          "$cond": [
            {
              "$ifNull": [
                "$awardDate",
                false
              ]
            },
            {
              "$year": "$awardDate"
            },
            null
          ]
        }
      }
    },
    {
      "$unwind": "$fundings"
    },
    {
      "$unwind": "$fundings.fundingCollaborators"
    },
    {
      "$match": {
        "fundings.fundingCollaborators.collaborator.uuid": "84443078-1a60-462d-9d0a-b04312afd9eb"
      }
    },
    {
      "$lookup": {
        "from": "ExternalOrganizations",
        "localField": "fundings.funder.uuid",
        "foreignField": "uuid",
        "as": "funder_info"
      }
    },
    {
      "$unwind": {
        "path": "$funder_info",
        "preserveNullAndEmptyArrays": true
      }
    },
    {
      "$unwind": {
        "path": "$funder_info.keywordGroups",
        "preserveNullAndEmptyArrays": true
      }
    },
    {
      "$unwind": {
        "path": "$funder_info.keywordGroups.classifications",
        "preserveNullAndEmptyArrays": true
      }
    },
    {
      "$addFields": {
        "importe": {
          "$convert": {
            "input": "$fundings.fundingCollaborators.institutionalPart.value",
            "to": "double",
            "onError": 0,
            "onNull": 0
          }
        },
        "award_tipo": {
          "$switch": {
            "branches": [
              {
                "case": {
                  "$in": [
                    "$type.term.ca_ES",
                    [
                      "Concessió conveni",
                      "Conveni extern a la UAB"
                    ]
                  ]
                },
                "then": {
                  "$concat": [
                    "$type.term.ca_ES",
                    " - ",
                    {
                      "$ifNull": [
                        "$funder_info.keywordGroups.classifications.term.ca_ES",
                        "Sense classificar"
                      ]
                    }
                  ]
                }
              },
              {
                "case": {
                  "$eq": [
                    "$fOpp.type.uri",
                    "/dk/atira/pure/fundingopportunity/fundingopportunitytypes/externalfundingopportunity/pro/pje"
                  ]
                },
                "then": "Programa Marc Europeu"
              },
              {
                "case": {
                  "$eq": [
                    "$fOpp.type.uri",
                    "/dk/atira/pure/fundingopportunity/fundingopportunitytypes/externalfundingopportunity/pro/itn"
                  ]
                },
                "then": "Altres ajuts int"
              },
              {
                "case": {
                  "$eq": [
                    "$fOpp.type.uri",
                    "/dk/atira/pure/fundingopportunity/fundingopportunitytypes/externalfundingopportunity/pro/pjn"
                  ]
                },
                "then": "Projectes R+D"
              }
            ],
            "default": "$type.term.ca_ES"
          }
        },
        "esLider": {
          "$let": {
            "vars": {
              "internalLeads": {
                "$filter": {
                  "input": { "$ifNull": ["$collaborators", []] },
                  "as": "c",
                  "cond": {
                    "$and": [
                      { "$eq": ["$$c.leadCollaborator", true] },
                      { "$eq": ["$$c.typeDiscriminator", "InternalCollaboratorAssociation"] }
                    ]
                  }
                }
              },
              "hasCollaborators": {
                "$gt": [{ "$size": { "$ifNull": ["$collaborators", []] } }, 0]
              }
            },
            "in": {
              "$cond": [
                "$$hasCollaborators",
                { "$gt": [{ "$size": "$$internalLeads" }, 0] },
                true
              ]
            }
          }
        }
      }
    },
    {
      "$group": {
        "_id": {
          "awardUuid": "$uuid",
          "anio": "$anio",
          "tipo": "$award_tipo",
          "categoria": "$categoria"
        },
        "totalImporte": {
          "$sum": "$importe"
        },
        "esLider": {
          "$first": "$esLider"
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "awardUuid": "$_id.awardUuid",
        "anio": "$_id.anio",
        "tipo": "$_id.tipo",
        "categoria": {
          "$ifNull": [
            "$_id.categoria",
            "Sense categoria"
          ]
        },
        "importe": "$totalImporte",
        "esLider": 1
      }
    },
    {
      "$group": {
        "_id": {
          "anio": "$anio",
          "tipo": "$tipo",
          "categoria": "$categoria",
          "esLider": "$esLider"
        },
        "ajuts": {
          "$sum": 1
        },
        "import": {
          "$sum": "$importe"
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "anio": "$_id.anio",
        "categoria": "$_id.categoria",
        "tipo": "$_id.tipo",
        "esLider": "$_id.esLider",
        "ajuts": 1,
        "import": {
          "$round": [
            "$import",
            2
          ]
        }
      }
    },
    {
      "$sort": {
        "anio": 1,
        "categoria": 1,
        "tipo": 1
      }
    }
  ]
}