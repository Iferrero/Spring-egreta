{
  "collection": "Awards",
  "pipeline": [
    {
      "$match": {
        "$or": [
          {
            "type.term.ca_ES": "Conveni extern a la UAB",
            "workflow.step": "approved"
          },
          {
            "type.term.ca_ES": { "$ne": "Conveni extern a la UAB" },
            "workflow.step": "validated"
          }
        ]
      }
    },
    {
      "$project": {
        "_id": 0,
        "categoria": "$categoria",
        "tipus": "$type.term.ca_ES"
      }
    },
    {
      "$match": {
        "categoria": {
          "$ne": null,
          "$nin": [""]
        },
        "tipus": {
          "$ne": null,
          "$nin": [""]
        }
      }
    },
    {
      "$group": {
        "_id": {
          "categoria": "$categoria",
          "tipus": "$tipus"
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "categoria": "$_id.categoria",
        "tipus": "$_id.tipus"
      }
    },
    {
      "$sort": {
        "categoria": 1,
        "tipus": 1
      }
    }
  ]
}
